{
  "name": "review-prototype",
  "version": "0.3.8",
  "description": "Figma-like comments for browser prototypes, shared through one review URL.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "DIALPAD_DESIGNERS.md",
    "INSTALL_WITH_AI.md",
    "PRIVACY.md",
    "SECURITY.md",
    "bin",
    "dist",
    "netlify",
    "netlify.toml",
    "scripts",
    "skills",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc"
  ],
  "bin": {
    "review-prototype": "bin/review-prototype.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "test": "node --test",
    "test:skill": "python3 -m unittest discover -s skills/review/scripts -p 'test_*.py'",
    "check": "npm test && npm run test:skill"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0"
  }
}
